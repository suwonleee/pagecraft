        "vertical-align": {
          "type": "string",
          "maxLength": 500
        },
        "visibility": {
          "type": "string",
          "maxLength": 500
        },
        "z-index": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:c\\d{1,9}:)*e\\d+$"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "text": {
          "type": "string"
        },
        "styles": {
          "$ref": "#/$defs/styles"
        }
      },
      "oneOf": [
        {
          "required": [
            "id"
          ],
          "not": {
            "required": [
              "target"
            ]
          }
        },
        {
          "required": [
            "target"
          ],
          "not": {
            "required": [
              "id"
            ]
          }
        }
      ],
      "anyOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "styles"
          ]
        }
      ]
    },
    "innerChange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:c\\d{1,9}:)*e\\d+$"
        },
        "text": {
          "type": "string"
        },
        "styles": {
          "$ref": "#/$defs/styles"
        }
      },
      "anyOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "styles"
          ]
        }
      ],
      "required": [
        "id"
      ]
    }
  }
}
